
<!DOCTYPE html>
<html lang="en">
<head>
<wonderful  charset="UTF-8">
<mzilahowa  name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#087443">
<title>Malawi Connect | Everything Malawi</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f6f4;color:#18251e}
header{background:#087443;color:white;padding:20px 16px;border-radius:0 0 22px 22px}
.brand{font-size:25px;font-weight:800}
.brand span{color:#ffd447}
header p{margin:8px 0 16px}
.search{width:100%;padding:14px;border:0;border-radius:12px;font-size:16px}
nav{display:flex;gap:8px;overflow:auto;padding:14px 10px;background:white}
nav a{color:#087443;text-decoration:none;font-weight:bold;white-space:nowrap;padding:8px}
main{padding:14px;max-width:800px;margin:auto}
.hero{background:linear-gradient(130deg,#087443,#13a56a);color:white;padding:24px;border-radius:18px}
.hero h1{font-size:28px;margin:0 0 10px}
.hero p{line-height:1.5}
.button{display:inline-block;background:#ffd447;color:#183c29;padding:12px 16px;border:0;border-radius:10px;font-weight:bold;text-decoration:none;cursor:pointer}
h2{font-size:20px;margin-top:25px}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.card{background:white;padding:16px 12px;border-radius:14px;box-shadow:0 2px 8px #0000000b}
.card .emoji{font-size:30px}
.card h3{margin:8px 0 5px;font-size:16px}
.card p{font-size:13px;color:#617067;line-height:1.5}
.card button,.action{background:#e4f5eb;color:#087443;border:0;padding:10px;border-radius:9px;font-weight:bold;cursor:pointer}
.section{scroll-margin-top:10px}
input,textarea,select{font:inherit}
.form{display:grid;gap:10px;background:white;padding:15px;border-radius:14px}
.form input,.form textarea,.form select{padding:12px;border:1px solid #d5ded8;border-radius:9px;width:100%}
.post{background:white;padding:15px;border-radius:12px;margin-bottom:10px;overflow-wrap:anywhere}
footer{margin-top:30px;background:#073d2a;color:white;text-align:center;padding:25px 15px}
.small{font-size:12px;color:#617067}
#notice{position:sticky;bottom:8px;background:#173e2c;color:white;padding:12px;border-radius:10px;display:none;margin-top:12px}
@media(min-width:600px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
</head>
<body>
<header>
<div class="brand">🇲🇼 Malawi <span>Connect</span></div>
<p>One country. One platform. Endless possibilities.</p>
<input id="search" class="search" placeholder="Search products, jobs, services..." oninput="searchItems()">
</header>

<nav>
<a href="#services">Services</a>
<a href="#market">Market</a>
<a href="#jobs">Jobs</a>
<a href="#transport">Transport</a>
<a href="#food">Food</a>
<a href="#social">Community</a>
</nav>

<main>
<section class="hero">
<h1>Welcome to Malawi Connect!</h1>
<p>Discover products, find jobs, learn new skills, order food and connect with people across Malawi.</p>
<a class="button" href="#services">Explore services ↓</a>
</section>

<section id="services" class="section">
<h2>Explore our services</h2>
<div class="grid">
<div class="card searchable"><div class="emoji">🛍️</div><h3>Marketplace</h3><p>Buy and sell products locally.</p><a class="action" href="#market">Explore market</a></div>
<div class="card searchable"><div class="emoji">💼</div><h3>Jobs & Careers</h3><p>Discover work opportunities.</p><a class="action" href="#jobs">Find jobs</a></div>
<div class="card searchable"><div class="emoji">🎓</div><h3>Education</h3><p>Discover learning resources.</p><a class="action" href="#education">Start learning</a></div>
<div class="card searchable"><div class="emoji">🏍️</div><h3>Kabaza</h3><p>Connect with motorcycle transport providers.</p><a class="action" href="#transport">Request ride</a></div>
<div class="card searchable"><div class="emoji">🚕</div><h3>Taxi</h3><p>Request a taxi ride.</p><a class="action" href="#transport">Request taxi</a></div>
<div class="card searchable"><div class="emoji">🍔</div><h3>Food delivery</h3><p>Discover food and local restaurants.</p><a class="action" href="#food">Explore food</a></div>
<div class="card searchable"><div class="emoji">👥</div><h3>Social community</h3><p>Share updates with visitors to this website.</p><a class="action" href="#social">Join community</a></div>
<div class="card searchable"><div class="emoji">🏠</div><h3>Property</h3><p>Explore houses and rentals.</p><a class="action" href="#market">Browse listings</a></div>
</div>
</section>

<section id="market" class="section">
<h2>🛍️ Marketplace</h2>
<p class="small">Sample listings — add your own below.</p>
<div class="grid" id="products">
<div class="card searchable"><div class="emoji">📱</div><h3>Mobile phones</h3><p>Explore phones and accessories.</p></div>
<div class="card searchable"><div class="emoji">👕</div><h3>Fashion</h3><p>Clothing, shoes and more.</p></div>
<div class="card searchable"><div class="emoji">🥬</div><h3>Fresh produce</h3><p>Discover local farm products.</p></div>
</div>
<h3>Post a product</h3>
<form class="form" id="productForm">
<input name="title" placeholder="Product name" required>
<input name="price" placeholder="Price in MWK" required>
<input name="contact" placeholder="Your phone number or contact" required>
<textarea name="description" placeholder="Product description"></textarea>
<button class="button">Add product listing</button>
</form>
</section>

<section id="jobs" class="section">
<h2>💼 Jobs & Careers</h2>
<p>Discover opportunities and share job vacancies.</p>
<form class="form" id="jobForm">
<input name="title" placeholder="Job title" required>
<input name="company" placeholder="Company or employer" required>
<input name="location" placeholder="Location in Malawi" required>
<input name="contact" placeholder="Application contact" required>
<button class="button">Post job vacancy</button>
</form>
<div id="jobListings"></div>
</section>

<section id="education" class="section">
<h2>🎓 Education & Learning</h2>
<div class="grid">
<div class="card"><div class="emoji">📚</div><h3>Study resources</h3><p>Organize learning materials and revision notes.</p></div>
<div class="card"><div class="emoji">💻</div><h3>Digital skills</h3><p>Explore technology and online learning.</p></div>
<div class="card"><div class="emoji">🏫</div><h3>Schools & colleges</h3><p>Discover education opportunities.</p></div>
</div>
</section>

<section id="transport" class="section">
<h2>🏍️ Transport booking</h2>
<form class="form" id="rideForm">
<select name="type"><option>Kabaza motorcycle</option><option>Taxi</option></select>
<input name="pickup" placeholder="Pickup location" required>
<input name="destination" placeholder="Destination" required>
<input name="phone" placeholder="Your phone number" required>
<button class="button">Prepare ride request</button>
</form>
</section>

<section id="food" class="section">
<h2>🍔 Food & Delivery</h2>
<div class="grid">
<div class="card"><div class="emoji">🍗</div><h3>Local meals</h3><p>Discover restaurants and local dishes.</p></div>
<div class="card"><div class="emoji">🥟</div><h3>Snacks</h3><p>Explore snacks and refreshments.</p></div>
</div>
<form class="form" id="foodForm">
<input name="meal" placeholder="Food or meal you want" required>
<input name="restaurant" placeholder="Restaurant, if known">
<input name="address" placeholder="Delivery location" required>
<input name="phone" placeholder="Your phone number" required>
<button class="button">Prepare food request</button>
</form>
</section>

<section id="social" class="section">
<h2>👥 Malawi Connect Community</h2>
<form class="form" id="postForm">
<input name="name" placeholder="Your display name" required>
<textarea name="message" placeholder="What would you like to share?" required></textarea>
<button class="button">Share update</button>
</form>
<div id="feed"></div>
</section>

<div id="notice" role="status"></div>
</main>

<footer>
<div class="brand">🇲🇼 Malawi Connect</div>
<p>Connecting people, businesses and opportunities across Malawi.</p>
<p class="small">First prototype • Built for Malawi</p>
</footer>

<script>
const notice=document.getElementById('notice');
function inform(message){
notice.textContent=message;
notice.style.display='block';
notice.scrollIntoView({behavior:'smooth',block:'nearest'});
}
function searchItems(){
const q=document.getElementById('search').value.toLowerCase();
document.querySelectorAll('.searchable').forEach(card=>{
card.style.display=card.textContent.toLowerCase().includes(q)?'':'none';
});
}
function addForm(id,container,render){
document.getElementById(id).addEventListener('submit',function(e){
e.preventDefault();
const data=Object.fromEntries(new FormData(this).entries());
render(data,container);
this.reset();
});
}
function safe(value){
const el=document.createElement('span');
el.textContent=value||'';
return el.innerHTML;
}
addForm('productForm','products',(d,c)=>{
const card=document.createElement('div');
card.className='card searchable';
card.innerHTML='<div class="emoji">📦</div><h3>'+safe(d.title)+'</h3><p>'+safe(d.description)+'</p><strong>MWK '+safe(d.price)+'</strong><p>Contact: '+safe(d.contact)+'</p>';
c.prepend(card);
inform('Product added to this page. It is not yet published online for other visitors.');
});
addForm('jobForm','jobListings',(d,c)=>{
const card=document.createElement('div');
card.className='post';
card.innerHTML='<h3>'+safe(d.title)+'</h3><p>'+safe(d.company)+' — '+safe(d.location)+'</p><p>Contact: '+safe(d.contact)+'</p>';
c.prepend(card);
inform('Job added to this page. It is not yet shared with other visitors.');
});
addForm('rideForm','',(d)=>{
const msg='Ride request: '+d.type+'\nPickup: '+d.pickup+'\nDestination: '+d.destination+'\nPhone: '+d.phone;
inform('Ride request prepared. No driver has been contacted and no booking is confirmed.');
const a=document.createElement('a');
a.className='button';
a.textContent='Copy ride request';
a.href='#transport';
a.onclick=()=>{if(navigator.clipboard)navigator.clipboard.writeText(msg);return false};
document.getElementById('rideForm').appendChild(a);
});
addForm('foodForm','',(d)=>{
inform('Food request prepared. No restaurant or delivery driver has been contacted.');
const p=document.createElement('p');
p.textContent='Order: '+d.meal+' | Delivery: '+d.address+' | Contact: '+d.phone;
document.getElementById('foodForm').appendChild(p);
});
addForm('postForm','feed',(d,c)=>{
const post=document.createElement('div');
post.className='post';
post.innerHTML='<strong>'+safe(d.name)+'</strong><p>'+safe(d.message)+'</p><small>Just now</small>';
c.prepend(post);
inform('Your update has been added to this page only.');
});
</script>
</body>
</html>
